{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "ALLOW_CLEARTEXT": "0",
        "EXPO_PUBLIC_API_URL": "https://amapi-sage.vercel.app"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "env": {
        "ALLOW_CLEARTEXT": "0",
        "EXPO_PUBLIC_API_URL": "https://amapi-sage.vercel.app",
        "EXPO_PUBLIC_REALTIME": "off"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "environment": "production",
      "env": {
        "ALLOW_CLEARTEXT": "0",
        "EXPO_PUBLIC_API_URL": "https://amapi-sage.vercel.app",
        "EXPO_PUBLIC_REALTIME": "off"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}

{
  "expo": {
    "name": "AAYME",
    "slug": "aayme",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aayme.b2b"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070720",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aayme.b2b",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "USE_BIOMETRIC",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "AAYME uses the camera to scan barcodes and shop QR codes.",
          "recordAudioAndroidPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AAYME uses your location to mark your shop and verify visits."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AAYME needs your photos to attach product pictures.",
          "cameraPermission": "AAYME needs the camera to photograph products."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2F6BFF"
        }
      ],
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "AAYME uses Face ID to unlock the app."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#070720"
        }
      ]
    ],
    "scheme": "aayme",
    "backgroundColor": "#070720",
    "extra": {
      "apiUrl": "https://amapi-sage.vercel.app",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d256d5f1-345b-4188-849a-c8c24995dc61"
      }
    },
    "owner": "gagangenius",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d256d5f1-345b-4188-849a-c8c24995dc61"
    }
  }
}
